<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00FFFFFF"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_space_20"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/ui_space_20"
        android:paddingBottom="24dp">


        <!-- ================================================== -->
        <!-- HERO / GOOD DAY CARD                               -->
        <!-- ================================================== -->

        <com.example.kayara.NeoCardView
            android:id="@+id/headerGreetingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="true"
                android:clipToPadding="true">


                <!--
                    ANIMATED CIRCLES

                    Kini na gyud ang moving circles.
                    Automatically starts when visible.
                -->

                <View
android:visibility="gone"                     android:id="@+id/heroAnimatedCircles"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false" />


                <!-- HERO TEXT -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ui_space_20"
                    android:paddingTop="17dp"
                    android:paddingEnd="@dimen/ui_space_20"
                    android:paddingBottom="18dp">


                    <!-- ROLE -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_role_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_crown"
                            android:contentDescription="@null"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvRoleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="COORDINATOR"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- GREETING -->

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Good day, Coordinator"
                        android:textAppearance="@style/TextAppearance.Univia.Title" />


                    <!-- SUBTITLE -->

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Campus Organization Overview"
                        android:textAppearance="@style/TextAppearance.Univia.Body" />

                </LinearLayout>

            </FrameLayout>

        </com.example.kayara.NeoCardView>


        <!-- ================================================== -->
        <!-- COMPOSE CARD                                       -->
        <!-- ================================================== -->

        <com.example.kayara.NeoCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#F2FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">


                <!-- WRITE POST -->

                <EditText
                    android:id="@+id/etComposeText"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_compose_textarea"
                    android:gravity="top"
                    android:hint="Write something for your organization..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />


                <!-- ================================================== -->
                <!-- PHOTO PREVIEW                                      -->
                <!-- ================================================== -->

                <LinearLayout
                    android:id="@+id/photoPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_compose_photo_preview"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Attached photos"
                            android:textColor="@color/brand_navy"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnRemovePhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="Remove all"
                            android:textColor="@color/error"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>


                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/photoPreviewList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>


                    <TextView
                        android:id="@+id/tvPhotoCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 photos selected"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- ================================================== -->
                <!-- ACTION BUTTONS                                     -->
                <!-- ================================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <!-- ADD PHOTO -->

                    <LinearLayout
                        android:id="@+id/btnAddPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_composed_action"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_photo"
                            android:contentDescription="@null"
                            app:tint="@color/brand_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="Add Photo"
                            android:textColor="@color/brand_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />


                    <!-- POST -->

                    <TextView
                        android:id="@+id/btnSubmitPost"
                        android:layout_width="92dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_post_submit_btn"
                        android:gravity="center"
                        android:text="Post"
                        android:textColor="@color/surface_card"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </com.example.kayara.NeoCardView>


        <!-- ================================================== -->
        <!-- RECENT POSTS                                       -->
        <!-- ================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="Recent Posts"
            android:textAppearance="@style/TextAppearance.Univia.Section" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_feed_text_post" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>