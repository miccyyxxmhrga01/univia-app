<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/loginScene" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/campus_login_background">
 <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="18dp" android:paddingTop="0dp" android:paddingBottom="10dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/login_brand_height" android:orientation="vertical" android:gravity="top|center_horizontal">
    <LinearLayout android:id="@+id/loginLogos" android:layout_marginTop="@dimen/login_brand_offset" android:layout_width="wrap_content" android:layout_height="90dp" android:gravity="center" android:orientation="horizontal">
     <FrameLayout android:layout_width="90dp" android:layout_height="90dp" android:background="@drawable/neo_circle">
      <ImageView android:id="@+id/loginBisuLogo" android:layout_width="74dp" android:layout_height="74dp" android:layout_gravity="center" android:src="@drawable/bisu_logo" android:contentDescription="@string/bisu_logo_description" />
     </FrameLayout>
     <FrameLayout android:layout_width="90dp" android:layout_height="90dp" android:layout_marginStart="1dp" android:background="@drawable/neo_circle">
      <ImageView android:id="@+id/loginAppLogo" android:layout_width="74dp" android:layout_height="74dp" android:layout_gravity="center" android:src="@drawable/univia_logo" android:contentDescription="@string/univia_logo_description" />
     </FrameLayout>
    </LinearLayout>
    <TextView android:includeFontPadding="false" android:id="@+id/loginCampusTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/login_campus_name_gap" android:gravity="center" android:text="@string/campus_login_name" android:textSize="24sp" android:textColor="@color/on_primary" android:shadowColor="#665B466F" android:shadowRadius="3" android:shadowDy="1" android:fontFamily="@font/poppins_semibold" />
    <ImageView android:layout_width="104dp" android:layout_height="10dp" android:layout_marginTop="-5dp" android:src="@drawable/campus_gold_swoosh" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="@dimen/login_university_gap" android:orientation="horizontal" android:gravity="center">
     <View android:layout_width="18dp" android:layout_height="1dp" android:background="#CCFFFFFF" />
     <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="6dp" android:text="@string/campus_university_name" android:textSize="8sp" android:letterSpacing="0.20" android:textColor="@color/on_primary" android:shadowColor="#995B466F" android:shadowRadius="2" />
     <View android:layout_width="18dp" android:layout_height="1dp" android:background="#CCFFFFFF" />
    </LinearLayout>
   </LinearLayout>
   <com.example.kayara.CampusLoginCard android:id="@+id/loginCard" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/loginForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="26dp" android:paddingTop="@dimen/login_card_top" android:paddingBottom="@dimen/login_card_bottom">
     <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Welcome back." android:fontFamily="@font/poppins_bold" android:textSize="28sp" app:lineHeight="34sp" android:textColor="@color/text_primary" />
     <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Manage your campus organization." android:textSize="13sp" android:textColor="@color/login_secondary" />
     <View android:layout_width="48dp" android:layout_height="3dp" android:layout_gravity="center" android:layout_marginTop="@dimen/login_label_gap" android:layout_marginBottom="@dimen/login_accent_bottom" android:background="@drawable/campus_accent_rule" />
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/glass_mail_outline" app:tint="@color/text_primary" android:contentDescription="@null" />
      <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="BISU email" android:labelFor="@id/etUsername" android:fontFamily="@font/poppins_semibold" android:textSize="14sp" android:textColor="@color/text_primary" />
     </LinearLayout>
     <EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="@dimen/login_field_height" android:layout_marginTop="1dp" android:paddingHorizontal="23dp" android:background="@drawable/neo_inset" android:hint="Enter your BISU email" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:singleLine="true" android:imeOptions="actionNext" android:fontFamily="@font/poppins_regular" android:textSize="14sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" />
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/login_label_gap" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/glass_lock_outline" app:tint="@color/text_primary" android:contentDescription="@null" />
      <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="Password" android:labelFor="@id/etPassword" android:fontFamily="@font/poppins_semibold" android:textSize="14sp" android:textColor="@color/text_primary" />
     </LinearLayout>
     <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/login_field_height" android:layout_marginTop="1dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/neo_inset" android:addStatesFromChildren="true">
      <EditText android:id="@+id/etPassword" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingStart="23dp" android:paddingEnd="0dp" android:background="@android:color/transparent" android:hint="Enter your password" android:inputType="textPassword" android:autofillHints="password" android:singleLine="true" android:fontFamily="@font/poppins_regular" android:textSize="14sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" />
      <ImageView android:id="@+id/btnTogglePassword" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_eye" app:tint="@color/text_secondary" android:contentDescription="@string/toggle_password" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
     </LinearLayout>
     <TextView android:includeFontPadding="false" android:id="@+id/tvError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/login_action_gap" android:padding="10dp" android:background="@drawable/bg_reject_btn" android:textColor="@color/error" android:textSize="12sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
     <LinearLayout android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="@dimen/login_action_height" android:layout_marginTop="@dimen/login_action_gap" android:gravity="center" android:orientation="horizontal" android:background="@drawable/neo_primary" android:clickable="true" android:focusable="true">
      <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sign in" android:fontFamily="@font/poppins_semibold" android:textSize="17sp" android:textColor="@color/on_primary" />
      <ImageView android:layout_width="23dp" android:layout_height="23dp" android:layout_marginStart="12dp" android:src="@drawable/glass_arrow_forward" app:tint="@color/on_primary" android:contentDescription="@null" />
     </LinearLayout>
     <TextView android:includeFontPadding="false" android:id="@+id/btnEditResubmit" android:layout_width="match_parent" android:layout_height="@dimen/login_registration_height" android:layout_marginTop="@dimen/login_action_gap" android:gravity="center" android:background="@drawable/neo_raised" android:text="Edit &amp; resubmit application" android:textSize="14sp" android:textColor="#5B21B6" android:clickable="true" android:focusable="true" android:visibility="gone" /><TextView android:includeFontPadding="false" android:id="@+id/tvGoToSignUp" android:layout_width="match_parent" android:layout_height="@dimen/login_registration_height" android:layout_marginTop="@dimen/login_action_gap" android:gravity="center" android:background="@drawable/neo_raised" android:text="Register your organization" android:fontFamily="@font/poppins_semibold" android:textSize="14sp" android:textColor="#5B21B6" android:clickable="true" android:focusable="true" />
    </LinearLayout>
   </com.example.kayara.CampusLoginCard>

  </LinearLayout>
 </androidx.core.widget.NestedScrollView>
</FrameLayout>
