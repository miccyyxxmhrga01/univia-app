<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <!-- =====================================================
         ORGANIZATION AVATAR
         Actual profile picture + initials fallback
         ===================================================== -->

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <!-- FALLBACK INITIALS -->

        <TextView
            android:id="@+id/tvBrowseAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="ORG"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- CURRENT ORGANIZATION PROFILE PICTURE -->

        <ImageView
            android:id="@+id/imgBrowseAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Organization profile picture" />

    </FrameLayout>

    <!-- =====================================================
         ORGANIZATION INFO
         ===================================================== -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBrowseOrgName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Organization Name"
            android:textColor="@color/dark_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvBrowseOrgMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Members"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- =====================================================
         STATUS / JOIN BUTTON
         ===================================================== -->

    <TextView
        android:id="@+id/tvBrowseStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="JOIN"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>