<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">


    <!-- =====================================================
         TOP BLUE HEADER
         ===================================================== -->

    <FrameLayout
        android:id="@+id/headerSection"
        android:layout_width="415dp"
        android:layout_height="172dp"
        android:background="@drawable/bg_v2_header_admin"
        android:clipChildren="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- DECORATIVE CIRCLE -->

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="-55dp"
            android:layout_marginEnd="-35dp"
            android:background="@drawable/bg_v2_deco_circle" />


        <View
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="-30dp"
            android:layout_marginBottom="-15dp"
            android:background="@drawable/bg_v2_deco_circle" />


        <!-- BACK BUTTON -->

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="18dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_header_icon_btn"
            android:clickable="true"
            android:contentDescription="Back"
            android:elevation="0dp"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/brand_blue" />


        <!-- HEADER TITLE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="93dp"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="COORDINATOR"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Renewal Review"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Review the organization's renewal submission"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>


    <!-- =====================================================
         SCROLLABLE BODY
         ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="30dp">


            <!-- =====================================================
                 ORGANIZATION SUMMARY CARD
                 ===================================================== -->

            <com.example.kayara.NeoCardView
                android:id="@+id/cardRenewal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="0dp"
                app:strokeColor="@color/surface_muted">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">


                    <!-- LABEL -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_blue">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_crown"
                                android:contentDescription="@null"
                                app:tint="@color/brand_blue" />

                        </FrameLayout>


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RENEWAL REQUEST"
                                android:textColor="@color/brand_blue"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Organization information"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- ORGANIZATION NAME -->

                    <TextView
                        android:id="@+id/tvOrganizationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Organization Name"
                        android:textColor="@color/brand_navy"
                        android:textSize="20sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvOrganizationCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ORG"
                        android:textColor="@color/brand_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />


                    <!-- DIVIDER -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/surface_muted" />


                    <!-- ACADEMIC YEAR ROW -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">


                        <!-- PREVIOUS -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PREVIOUS YEAR"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvPreviousAcademicYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="2025-2026"
                                android:textColor="@color/brand_navy"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- CURRENT -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CURRENT YEAR"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvCurrentAcademicYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="2025-2026"
                                android:textColor="@color/brand_navy"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- RENEWING YEAR -->

                    <com.example.kayara.NeoCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeWidth="0dp"
                        app:strokeColor="@color/surface_muted">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="RENEWAL REQUESTED FOR"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvRenewingAcademicYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="2026-2027"
                                    android:textColor="@color/brand_blue"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </LinearLayout>


                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_v2_icon_blue"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="7dp"
                                android:paddingBottom="7dp"
                                android:text="PENDING"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.example.kayara.NeoCardView>

                </LinearLayout>

            </com.example.kayara.NeoCardView>


            <!-- =====================================================
                 REQUIREMENTS HEADER
                 ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uploaded Requirements"
                    android:textColor="@color/brand_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Check each submitted document before making your decision."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- DYNAMIC REQUIREMENTS -->

            <LinearLayout
                android:id="@+id/layoutRenewalRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />


            <!-- =====================================================
                 REVIEW DECISION
                 ===================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Review Decision"
                android:textColor="@color/brand_navy"
                android:textSize="17sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="A reason is only required when rejecting the renewal."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />


            <!-- REJECTION BOX -->

            <com.example.kayara.NeoCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="0dp"
                app:strokeColor="@color/surface_muted">

                <EditText
                    android:id="@+id/etRejectionReason"
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="Enter rejection reason..."
                    android:padding="16dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />

            </com.example.kayara.NeoCardView>


            <!-- =====================================================
                 ACTION BUTTONS
                 ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">


                <!-- REJECT -->

                <Button
                    android:id="@+id/btnReject"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/error"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="REJECT"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <!-- APPROVE -->

                <Button
                    android:id="@+id/btnApprove"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/brand_blue"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="APPROVE"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Review carefully before approving or rejecting."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>