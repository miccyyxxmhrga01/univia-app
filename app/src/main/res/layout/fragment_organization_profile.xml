<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/organizationProfileScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="110dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ===================================================== -->
        <!-- PROFILE HERO / COVER                                  -->
        <!-- ===================================================== -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="205dp"
            android:clipChildren="false">


            <!-- COVER CARD -->

            <com.example.kayara.NeoCardView
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#26FFFFFF"
                app:strokeWidth="0dp">


                <FrameLayout
                    android:id="@+id/coverContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_cover_placeholder">


                    <!-- REAL COVER PHOTO -->

                    <ImageView
                        android:id="@+id/imgCoverPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/cover_photo_desc" />


                    <!-- SOFT OVERLAY -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#123B176A" />


                    <!-- CHANGE COVER -->

                    <FrameLayout
                        android:id="@+id/btnChangeCover"
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_header_icon_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_photo"
                            android:contentDescription="@string/change_cover"
                            app:tint="@color/text_primary" />

                    </FrameLayout>

                </FrameLayout>

            </com.example.kayara.NeoCardView>


            <!-- ORGANIZATION AVATAR -->

            <FrameLayout
                android:id="@+id/avatarClickArea"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="30dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_avatar_frame_white"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp"
                android:clipChildren="false">


                <!-- INITIALS FALLBACK -->

                <TextView
                    android:id="@+id/tvOrgAvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_org_avatar_large"
                    android:gravity="center"
                    android:text="ORG"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:clipToOutline="true"
                    android:outlineProvider="background" />


                <!-- REAL ORGANIZATION AVATAR -->

                <ImageView
                    android:id="@+id/imgOrgAvatarPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_org_avatar_large"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:clipToOutline="true"
                    android:outlineProvider="background"
                    android:contentDescription="@string/org_logo" />


                <!-- CHANGE AVATAR -->

                <FrameLayout
                    android:id="@+id/btnChangeAvatar"
                    android:layout_width="29dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_camera_overlay"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="0dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_photo"
                        android:contentDescription="@string/org_logo"
                        app:tint="@color/white" />

                </FrameLayout>

            </FrameLayout>

        </FrameLayout>


        <!-- ===================================================== -->
        <!-- ORGANIZATION INFORMATION                              -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">


            <!-- NAME + EDIT -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/tvOrgName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Organization"
                        android:textColor="@color/dark_blue"
                        android:textSize="21sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvOrgCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Student Organization"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- EDIT PROFILE -->

                <LinearLayout
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_edit"
                        android:contentDescription="@string/edit_profile"
                        app:tint="@color/blue_deep" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Edit"
                        android:textColor="@color/blue_deep"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- DESCRIPTION -->

            <TextView
                android:id="@+id/tvOrgDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Organization profile and activities."
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:lineSpacingExtra="2dp" />


            <!-- ================================================= -->
            <!-- STATISTICS                                       -->
            <!-- ================================================= -->

            <com.example.kayara.NeoCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_muted"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:id="@+id/statsCard"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <!-- MEMBERS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatMembers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dark_blue"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Members"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <View
                        android:layout_width="1dp"
                        android:layout_height="38dp"
                        android:background="@color/surface_muted" />


                    <!-- POSTS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatPosts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dark_blue"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Posts"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <View
                        android:layout_width="1dp"
                        android:layout_height="38dp"
                        android:background="@color/surface_muted" />


                    <!-- EVENTS -->

                    <LinearLayout
                        android:id="@+id/layoutStatEvents"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tvStatEvents"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dark_blue"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Events"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.example.kayara.NeoCardView>


            <!-- ================================================= -->
            <!-- TABS                                             -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/profileTabs"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">


                <!-- POSTS -->

                <LinearLayout
                    android:id="@+id/tabPosts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTabPosts"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Posts"
                        android:textColor="@color/dark_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/underlinePosts"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_tab_underline_active" />

                </LinearLayout>


                <!-- ABOUT -->

                <LinearLayout
                    android:id="@+id/tabAbout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTabAbout"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="About"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/underlineAbout"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/card_border" />

                </LinearLayout>


                <!-- MEMBERS -->

                <LinearLayout
                    android:id="@+id/tabMembers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTabMembers"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Members"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/underlineMembers"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/card_border" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- POSTS CONTENT                                         -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/contentPosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrgProfileFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="25dp"
                tools:listitem="@layout/item_feed_text_post" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ABOUT CONTENT                                         -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/contentAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp"
            android:visibility="gone">


            <com.example.kayara.NeoCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_muted"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:id="@+id/organizationInformationCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">


                    <!-- DESCRIPTION -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESCRIPTION"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvAboutDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="17dp"
                        android:text="Organization profile and activities."
                        android:textColor="@color/dark_blue"
                        android:textSize="12.5sp"
                        android:lineSpacingExtra="2dp" />


                    <!-- CATEGORY -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CATEGORY"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvAboutCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="17dp"
                        android:text="Student Organization"
                        android:textColor="@color/dark_blue"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <!-- ================================================= -->
                    <!-- ADVISERS -->
                    <!-- ================================================= -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADVISERS"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />


                    <!-- ADVISER 1 -->

                    <LinearLayout
                        android:id="@+id/layoutAdviser1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAboutAdviser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Organization Adviser"
                            android:textColor="@color/dark_blue"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- ADVISER 2 -->

                    <LinearLayout
                        android:id="@+id/layoutAdviser2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvAboutAdviser2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Second Organization Adviser"
                            android:textColor="@color/dark_blue"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAboutAdviserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="17dp"
                        android:text="No email available"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />


                    <!-- FOUNDED -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FOUNDED"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvAboutFounded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Not specified"
                        android:textColor="@color/dark_blue"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.example.kayara.NeoCardView>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- MEMBERS CONTENT                                       -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/contentMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrgProfileMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="20dp"
                tools:listitem="@layout/item_member" />

        </LinearLayout>


    </LinearLayout>

</androidx.core.widget.NestedScrollView>