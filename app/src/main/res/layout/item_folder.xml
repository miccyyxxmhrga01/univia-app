<com.example.kayara.NeoCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/surface" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="138dp" android:orientation="vertical" android:paddingStart="13dp" android:paddingTop="14dp" android:paddingEnd="13dp" android:paddingBottom="12dp">
        <ImageView android:id="@+id/imgFolderIcon" android:layout_width="34dp" android:layout_height="30dp" android:layout_marginBottom="9dp" android:contentDescription="@null" android:src="@drawable/ic_folder" app:tint="@color/brand_blue"/>
        <TextView android:id="@+id/tvFolderOrgName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:ellipsize="end" android:maxLines="2" android:text="Organization Name" android:textColor="@color/dark_blue" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvFolderMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 files" android:textColor="@color/text_gray" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvFolderBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_folder_badge_clear" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingEnd="7dp" android:paddingBottom="3dp" android:text="CLEAR" android:textColor="@color/teal_deep" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
</com.example.kayara.NeoCardView>