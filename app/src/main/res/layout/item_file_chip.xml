<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_input_pill_white"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="8dp"
        android:background="@drawable/bg_doc_icon"
        android:src="@drawable/ic_nav_documents"
        app:tint="@color/blue_deep"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Document.pdf"
            android:textColor="@color/dark_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvFileSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 KB"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnRemoveFile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="18dp"
        android:background="@drawable/bg_remove_badge"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/remove_file"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>