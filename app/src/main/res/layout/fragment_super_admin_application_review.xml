<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingBottom="115dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">


        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- BACK -->

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_application_back"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/brand_navy"
                android:textSize="29sp"
                android:textStyle="bold" />


            <!-- TITLE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Review Application"
                    android:textColor="@color/brand_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Review the submitted organization information."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- STATUS -->

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_application_status"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="PENDING"
                android:textColor="@color/brand_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ORGANIZATION CARD                                     -->
        <!-- ===================================================== -->

        <com.example.kayara.NeoCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_muted"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="ORGANIZATION"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOrganizationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Organization Name"
                    android:textColor="@color/brand_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Organization description"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.example.kayara.NeoCardView>


        <!-- ===================================================== -->
        <!-- APPLICANT CARD                                        -->
        <!-- ===================================================== -->

        <com.example.kayara.NeoCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_muted"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="APPLICANT INFORMATION"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvApplicantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Applicant Name"
                    android:textColor="@color/brand_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Username"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Email"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.example.kayara.NeoCardView>


        <!-- ===================================================== -->
        <!-- VERIFICATION DOCUMENTS                                -->
        <!-- ===================================================== -->

        <com.example.kayara.NeoCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_muted"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- DOCUMENT SECTION HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="VERIFICATION DOCUMENTS"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDocumentStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 of 5 documents submitted"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_application_status"
                        android:paddingStart="9dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="5dp"
                        android:text="5 REQUIRED"
                        android:textColor="@color/brand_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- DOCUMENT 1                                        -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@color/surface"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDocument1Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Police Clearance of Lead Organizer"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDocument1Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Not submitted"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnViewDocument1"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_application_document_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="View Police Clearance"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- DOCUMENT 2                                        -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDocument2Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Proposed Constitution and By-Laws"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDocument2Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Not submitted"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnViewDocument2"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_application_document_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="View Constitution &amp; By-Laws"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- DOCUMENT 3                                        -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDocument3Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="List of Members (Minimum of 30 Members)"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDocument3Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Not submitted"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnViewDocument3"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_application_document_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="View List of Members"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- DOCUMENT 4                                        -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDocument4Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Names of Two (2) Nominees for Organization Adviser"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDocument4Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Not submitted"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnViewDocument4"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_application_document_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="View Adviser Nominees"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- DOCUMENT 5                                        -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDocument5Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Annual Work Plan of Activities"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDocument5Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Not submitted"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnViewDocument5"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_application_document_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="View Annual Work Plan"
                        android:textColor="@color/brand_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.example.kayara.NeoCardView>


        <!-- ===================================================== -->
        <!-- DECISION SECTION                                      -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginTop="17dp"
            android:text="APPLICATION DECISION"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />


        <!-- APPROVE -->

        <TextView
            android:id="@+id/btnApprove"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_v2_btn_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Approve Application"
            android:textColor="@color/surface_card"
            android:textSize="12sp"
            android:textStyle="bold" />


        <!-- REJECT -->

        <TextView
            android:id="@+id/btnReject"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_application_reject"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Reject Application"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>