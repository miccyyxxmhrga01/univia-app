<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_gradient_admin"
        android:elevation="0dp"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">


        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_header_icon_btn"
            android:padding="14dp"
            android:src="@drawable/ic_chat_back"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Organization Profile"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Update how students see your organization"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- FORM -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- ============================================= -->
            <!-- CARD: BASIC INFORMATION -->
            <!-- ============================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Basic information"
                    android:textColor="@color/dark_blue"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="This is what students see on your profile."
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />


                <!-- ORGANIZATION NAME -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="ORGANIZATION NAME"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />


                <EditText
                    android:id="@+id/etEditOrgName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search"
                    android:hint="e.g. Red Cross Youth"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/dark_blue"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />


                <!-- CATEGORY -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="CATEGORY"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />


                <EditText
                    android:id="@+id/etEditOrgCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search"
                    android:hint="e.g. Service / Academic / Arts"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/dark_blue"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />


                <!-- YEAR FOUNDED -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="YEAR FOUNDED"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />


                <EditText
                    android:id="@+id/etEditOrgFounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search"
                    android:hint="e.g. 2015"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/dark_blue"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />


                <!-- ============================================= -->
                <!-- ADVISERS -->
                <!-- ============================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ORGANIZATION ADVISERS"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Add the faculty adviser or advisers currently assigned to the organization."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />


                <!-- ADVISER 1 -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:text="ADVISER 1"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <EditText
                    android:id="@+id/etEditOrgAdviser1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search"
                    android:hint="Enter primary adviser"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/dark_blue"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />


                <!-- ADVISER 2 -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:text="ADVISER 2 (OPTIONAL)"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <EditText
                    android:id="@+id/etEditOrgAdviser2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search"
                    android:hint="Enter second adviser if applicable"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/dark_blue"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />


                <!-- DESCRIPTION -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="DESCRIPTION"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />


                <EditText
                    android:id="@+id/etEditOrgDescription"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_compose_textarea"
                    android:gravity="top|start"
                    android:hint="Tell students what your organization is about..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textColor="@color/dark_blue"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ============================================= -->
            <!-- CARD: RECRUITMENT -->
            <!-- ============================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recruitment"
                        android:textColor="@color/dark_blue"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_admin_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="SHOWN WHEN JOINING"
                        android:textColor="@color/blue_deep"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tell students what to do when they apply to join."
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />


                <!-- ============================================= -->
                <!-- RECRUITMENT STATUS -->
                <!-- ============================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_note"
                    android:padding="14dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">


                            <TextView
                                android:id="@+id/tvRecruitmentStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recruitment is OPEN"
                                android:textColor="@color/dark_blue"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/tvRecruitmentStatusHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Students can send join requests."
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                        </LinearLayout>


                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchRecruitmentOpen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:text="MEMBER LIMIT (OPTIONAL)"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />


                    <EditText
                        android:id="@+id/etRecruitmentLimit"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_search"
                        android:hint="e.g. 50 (leave blank for no limit)"
                        android:inputType="number"
                        android:maxLength="5"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="@color/dark_blue"
                        android:textColorHint="@color/text_hint"
                        android:textSize="13sp" />


                    <TextView
                        android:id="@+id/tvRecruitmentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Current members: 0"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- INSTRUCTIONS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="INSTRUCTIONS FOR APPLICANTS"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />


                <EditText
                    android:id="@+id/etEditRecruitmentInfo"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_compose_textarea"
                    android:gravity="top|start"
                    android:hint="e.g. Fill out the application form, then upload your COR and a 2x2 photo."
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textColor="@color/dark_blue"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />


                <!-- FILES FOR APPLICANTS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="FILES FOR APPLICANTS"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="Forms, flyers, or guidelines students can open and download."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />


                <LinearLayout
                    android:id="@+id/filesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />


                <TextView
                    android:id="@+id/tvFilesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="No files attached yet."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/tvUploadStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Uploading..."
                    android:textColor="@color/blue_deep"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />


                <TextView
                    android:id="@+id/btnAddRecruitFile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_add_photo_button"
                    android:gravity="center"
                    android:text="+  Attach a file"
                    android:textColor="@color/blue_deep"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- REQUIREMENTS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="WHAT STUDENTS MUST SUBMIT"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="Each item becomes an upload slot when a student joins."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />


                <LinearLayout
                    android:id="@+id/requirementsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />


                <TextView
                    android:id="@+id/tvRequirementsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="No requirements yet. Students can join without uploading documents."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/btnAddRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_add_photo_button"
                    android:gravity="center"
                    android:text="+  Add requirement"
                    android:textColor="@color/blue_deep"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- SAVE BAR -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="0dp"
        android:padding="14dp">


        <LinearLayout
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_post_submit_btn"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">


            <TextView
                android:id="@+id/tvSaveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save changes"
                android:textColor="@color/surface_card"
                android:textSize="13.5sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>