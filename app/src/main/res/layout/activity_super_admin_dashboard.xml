<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- ===================================================== -->
    <!-- SUPER ADMIN HEADER                                    -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:minHeight="@dimen/ui_nav_min_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_nav_min_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp" android:src="@drawable/bisu_logo" android:contentDescription="@string/bisu_logo_description" />
<FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_org_badge"
                android:elevation="0dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/univia_logo"
                    android:contentDescription="@null"
                     />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderCampus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="Campus Organization"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_header_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat_message"
                    android:contentDescription="Org Managers group chat"
                    app:tint="@color/text_primary" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_header_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile_person"
                    android:contentDescription="@string/profile"
                    app:tint="@color/text_primary" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- LIGHT CURVED CONTENT                                  -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/mainContentSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_header_curve_super_admin"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="14dp"
            android:paddingBottom="@dimen/ui_space_8"
            tools:layout="@layout/fragment_dashboard" />

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- FAB                                                   -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="@dimen/ui_space_8"
        android:background="@drawable/bg_fab"
        android:padding="15dp"
        android:src="@drawable/ic_add"
        android:elevation="0dp"
        android:visibility="gone"
        android:contentDescription="@string/add_folder"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav" />


    <!-- ===================================================== -->
    <!-- FLOATING BOTTOM NAV                                   -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/customBottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:minHeight="@dimen/ui_nav_min_height"
        android:background="@drawable/bg_glass_bottom_nav">


        <LinearLayout
            android:id="@+id/navItemsContainer" android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="0dp"
            android:minHeight="@dimen/ui_nav_min_height">


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/ui_nav_min_height"
                android:paddingTop="@dimen/ui_space_8"
                android:paddingBottom="@dimen/ui_space_8">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_dashboard"
                    app:tint="@color/brand_blue"
                    android:contentDescription="@string/nav_home" />

                <TextView
                    android:id="@+id/labelHome" android:maxLines="2" android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/underlineHome"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>


            <!-- ORGANIZATIONS -->

            <LinearLayout
                android:id="@+id/navOrganizations"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/ui_nav_min_height"
                android:paddingTop="@dimen/ui_space_8"
                android:paddingBottom="@dimen/ui_space_8">

                <ImageView
                    android:id="@+id/iconOrganizations"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_orgs"
                    app:tint="@color/text_hint"
                    android:contentDescription="@string/nav_organizations" />

                <TextView
                    android:id="@+id/labelOrganizations" android:maxLines="2" android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Orgs"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/underlineOrganizations"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>


            <!-- NOTIFICATIONS -->

            <LinearLayout
                android:id="@+id/navNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/ui_nav_min_height"
                android:paddingTop="@dimen/ui_space_8"
                android:paddingBottom="@dimen/ui_space_8">

                <ImageView
                    android:id="@+id/iconNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/text_hint"
                    android:contentDescription="@string/nav_notifications" />

                <TextView
                    android:id="@+id/labelNotifications" android:maxLines="2" android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Alerts"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/underlineNotifications"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>


            <!-- DOCUMENTS -->

            <LinearLayout
                android:id="@+id/navDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/ui_nav_min_height"
                android:paddingTop="@dimen/ui_space_8"
                android:paddingBottom="@dimen/ui_space_8">

                <ImageView
                    android:id="@+id/iconDocuments"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_documents"
                    app:tint="@color/text_hint"
                    android:contentDescription="@string/nav_documents" />

                <TextView
                    android:id="@+id/labelDocuments" android:maxLines="2" android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Documents"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/underlineDocuments"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>