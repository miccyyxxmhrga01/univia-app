<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_application_card"
    android:padding="17dp">

    <!-- ORGANIZATION INITIAL -->
    <TextView
        android:id="@+id/tvOrgInitial"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="O"
        android:textColor="@color/surface_card"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_admin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ORGANIZATION NAME -->
    <TextView
        android:id="@+id/tvOrganizationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="8dp"
        android:text="Organization Name"
        android:textColor="@color/brand_navy"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/tvOrgInitial"
        app:layout_constraintStart_toEndOf="@id/tvOrgInitial"
        app:layout_constraintEnd_toStartOf="@id/tvStatus" />

    <!-- APPLICANT NAME -->
    <TextView
        android:id="@+id/tvApplicantName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:text="Applicant Name"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tvOrganizationName"
        app:layout_constraintStart_toEndOf="@id/tvOrgInitial"
        app:layout_constraintEnd_toStartOf="@id/tvStatus" />

    <!-- STATUS -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="PENDING"
        android:textColor="@color/brand_blue"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_application_status"
        app:layout_constraintTop_toTopOf="@id/tvOrgInitial"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- EMAIL -->
    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="admin@email.com"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tvOrgInitial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DATE -->
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Submitted recently"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- VIEW BUTTON -->
    <TextView
        android:id="@+id/btnViewApplication"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="View Application"
        android:textColor="@color/surface_card"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_admin"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/tvDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>