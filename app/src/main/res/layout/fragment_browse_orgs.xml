<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ui_space_20">

        <!-- ORGANIZATIONS HEADING -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organizations"
            android:textColor="@color/dark_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- EXISTING SEARCH BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_touch_target"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="13dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/etSearchOrgStudent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:background="@null"
                android:hint="Search organizations..."
                android:minHeight="@dimen/ui_touch_target"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/ui_text_body"
                android:inputType="text" />

        </LinearLayout>

        <!-- AI MATCHER CARD -->

        <com.example.kayara.NeoCardView
            android:id="@+id/btnSmartMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="17dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Find My Organization with AI"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ui_space_20"
                android:importantForAccessibility="noHideDescendants">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/ui_space_12"
                        android:src="@drawable/ic_interest"
                        android:contentDescription="@null"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Find your organization with AI"
                        android:textAppearance="@style/TextAppearance.Univia.Action" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_8"
                    android:text="Discover groups that match your interests."
                    android:textAppearance="@style/TextAppearance.Univia.Body"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_touch_target"
                    android:layout_marginTop="@dimen/ui_space_8"
                    android:gravity="center_vertical"
                    android:text="Find My Match &#8594;"
                    android:textAppearance="@style/TextAppearance.Univia.Action" />
            </LinearLayout>

        </com.example.kayara.NeoCardView>

        <!-- EXISTING FILTERS -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ui_space_16"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="0dp">

                <TextView
                    android:id="@+id/chipAllStudentOrgs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_active"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="All (2)"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/ui_text_body"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/ui_touch_target"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/chipJoined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Joined (1)"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/ui_text_body"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/ui_touch_target"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/chipPendingOrgs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Pending (0)"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/ui_text_body"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/ui_touch_target"
                    android:gravity="center" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- EXISTING ORGANIZATION LIST -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBrowseOrgs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_browse_org" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
