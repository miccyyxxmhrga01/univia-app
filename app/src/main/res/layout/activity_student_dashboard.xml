<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_header_gradient_student"
    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- ===================================================== -->
    <!-- STUDENT HEADER                                        -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient_student"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:minHeight="@dimen/ui_nav_min_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_nav_min_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp" android:src="@drawable/bisu_logo" android:contentDescription="@string/bisu_logo_description" />
<FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_avatar_badge"
                android:elevation="0dp">

                <TextView
                    android:id="@+id/tvUserInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="ST"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="Campus Organization"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_header_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat_message"
                    android:contentDescription="Group chat"
                    app:tint="@color/text_primary" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CURVED CONTENT                                        -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/mainContentSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_header_curve_student"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="14dp">


            <!-- =============================================== -->
            <!-- STUDENT HERO                                    -->
            <!-- =============================================== -->

            <com.example.kayara.NeoCardView
                android:id="@+id/headerGreetingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@integer/dashboard_greeting_visibility"
                android:layout_marginStart="@dimen/ui_space_20"
                android:layout_marginEnd="@dimen/ui_space_20"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#35FFFFFF"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="140dp"
                    android:background="@android:color/transparent"
                    android:clipChildren="true"
                    android:clipToPadding="true">


                    <View
android:visibility="gone"                         android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="@dimen/ui_space_20"
                        android:paddingBottom="@dimen/ui_space_20">


                        <!-- ROLE -->

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_role_pill"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="11dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_profile_person"
                                app:tint="@color/text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="STUDENT"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:includeFontPadding="false"
                            android:text="Hi, Student!"
                            android:textAppearance="@style/TextAppearance.Univia.Title" />


                        <TextView
                            android:id="@+id/tvSubGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:includeFontPadding="false"
                            android:text="@string/univia_welcome"
                            android:textAppearance="@style/TextAppearance.Univia.Body" />

                    </LinearLayout>

                </FrameLayout>

            </com.example.kayara.NeoCardView>


            <!-- FRAGMENT -->

            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/ui_space_8"
                tools:layout="@layout/fragment_student_dashboard" />

        </LinearLayout>

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- BOTTOM NAV                                            -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/customBottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:minHeight="@dimen/ui_nav_min_height"
        android:background="@drawable/bg_glass_bottom_nav">


        <LinearLayout
            android:id="@+id/navItemsContainer" android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="0dp"
            android:minHeight="@dimen/ui_nav_min_height">


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/ui_nav_min_height"
                android:paddingTop="@dimen/ui_space_8"
                android:paddingBottom="@dimen/ui_space_8">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_dashboard"
                    app:tint="@color/teal_deep_text"
                    android:contentDescription="@string/nav_home" />

                <TextView
                    android:id="@+id/labelHome" android:maxLines="2" android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ORGANIZATIONS -->

            <LinearLayout
                android:id="@+id/navOrgs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/ui_nav_min_height"
                android:paddingTop="@dimen/ui_space_8"
                android:paddingBottom="@dimen/ui_space_8">

                <ImageView
                    android:id="@+id/iconOrgs"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_orgs"
                    app:tint="@color/text_hint"
                    android:contentDescription="@string/nav_organizations" />

                <TextView
                    android:id="@+id/labelOrgs" android:maxLines="2" android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Orgs"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- NOTIFICATIONS -->

            <LinearLayout
                android:id="@+id/navNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/ui_nav_min_height"
                android:paddingTop="@dimen/ui_space_8"
                android:paddingBottom="@dimen/ui_space_8">

                <ImageView
                    android:id="@+id/iconNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/text_hint"
                    android:contentDescription="@string/nav_notifications" />

                <TextView
                    android:id="@+id/labelNotifications" android:maxLines="2" android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Alerts"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- PROFILE -->

            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/ui_nav_min_height"
                android:paddingTop="@dimen/ui_space_8"
                android:paddingBottom="@dimen/ui_space_8">

                <ImageView
                    android:id="@+id/iconProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_profile_person"
                    app:tint="@color/text_hint"
                    android:contentDescription="@string/nav_profile" />

                <TextView
                    android:id="@+id/labelProfile" android:maxLines="2" android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Profile"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
