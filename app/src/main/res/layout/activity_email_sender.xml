<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/bg_light">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:focusableInTouchMode="true">
        <com.google.android.material.button.MaterialButton style="?attr/materialButtonOutlinedStyle"
            android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="Back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/sender_title" android:textSize="26sp"
            android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_primary" />
        <TextView style="@style/RegistrationBody" android:layout_marginTop="12dp" android:text="@string/sender_description" />
        <TextView style="@style/RegistrationLabel" android:text="@string/sender_email" android:labelFor="@id/senderEmail" />
        <EditText android:id="@+id/senderEmail" style="@style/RegistrationInput" android:inputType="textEmailAddress"
            android:hint="organizationapp1102@gmail.com" android:singleLine="true" />
        <TextView style="@style/RegistrationLabel" android:text="@string/sender_password" android:labelFor="@id/senderPassword" />
        <EditText android:id="@+id/senderPassword" style="@style/RegistrationInput" android:inputType="textPassword"
            android:hint="@string/sender_password_hint" android:maxLength="32" android:singleLine="true"
            android:saveEnabled="false" android:importantForAutofill="no" />
        <TextView style="@style/RegistrationBody" android:layout_marginTop="12dp" android:text="@string/sender_privacy" />
        <TextView android:id="@+id/senderStatus" style="@style/RegistrationBody" android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite" android:text="@string/sender_not_ready" />
        <com.google.android.material.button.MaterialButton android:id="@+id/connectSender" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="54dp" android:layout_marginTop="24dp"
            android:text="@string/sender_connect" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
