<?xml version="1.0" encoding="utf-8"?>

<com.example.kayara.NeoCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginBottom="@dimen/ui_space_16"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/ui_space_16"
        android:paddingStart="@dimen/feed_surface_inset"
        android:paddingEnd="@dimen/feed_surface_inset"
        android:paddingBottom="@dimen/feed_surface_inset">


        <!-- ===================================================== -->
        <!-- POST HEADER                                           -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">


            <!-- PROFILE AVATAR -->

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp">

                <TextView
                    android:id="@+id/tvPosterAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="ORG"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgPosterAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Organization profile picture"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </FrameLayout>


            <!-- NAME + TIME -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPosterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organization"
                    android:textColor="@color/brand_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Just now"
                    android:textAppearance="@style/TextAppearance.Univia.Metadata" />

            </LinearLayout>


            <!-- POST MENU -->

            <ImageView
                android:id="@+id/btnPostMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="Post menu"
                android:focusable="true"
                android:padding="15dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/brand_blue" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- CAPTION                                               -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="5"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Caption here"
            android:textColor="@color/brand_navy"
            android:textSize="14sp" />


        <!-- SEE MORE / SEE LESS -->

        <TextView
            android:id="@+id/tvSeeMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:text="See more"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Univia.Action"
            android:minHeight="@dimen/ui_touch_target"
            android:minWidth="@dimen/ui_touch_target"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground" />


        <!-- ===================================================== -->
        <!-- PHOTOS                                                -->
        <!-- ===================================================== -->

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/photoViewPager"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/surface" />

        <!-- DOT INDICATOR -->

        <LinearLayout
            android:id="@+id/layoutDotIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal" />


        <!-- PHOTO COUNTER -->

        <TextView
            android:id="@+id/tvPhotoCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:visibility="gone" />


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/surface_muted" />


        <!-- ===================================================== -->
        <!-- ACTIONS                                               -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">


            <!-- LIKE -->

            <LinearLayout
                android:id="@+id/btnLike"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:minWidth="@dimen/ui_touch_target"
                android:minHeight="@dimen/ui_touch_target"
                android:layout_marginStart="0dp"
                android:background="?attr/selectableItemBackground"
                android:screenReaderFocusable="true">

                <ImageView
                    android:id="@+id/imgHeart"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Like"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/brand_navy" />

                <TextView
                    android:id="@+id/tvLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="0"
                    android:textColor="@color/brand_navy"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- COMMENT -->

            <LinearLayout
                android:id="@+id/btnComment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="0dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:minWidth="@dimen/ui_touch_target"
                android:minHeight="@dimen/ui_touch_target"
                android:background="?attr/selectableItemBackground"
                android:screenReaderFocusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Comment"
                    android:src="@drawable/ic_comment"
                    app:tint="@color/brand_navy" />

                <TextView
                    android:id="@+id/tvCommentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="0"
                    android:textColor="@color/brand_navy"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- SHARE -->

            <LinearLayout
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="0dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:minWidth="@dimen/ui_touch_target"
                android:minHeight="@dimen/ui_touch_target"
                android:background="?attr/selectableItemBackground"
                android:screenReaderFocusable="true">

                <ImageView
                    android:id="@+id/imgShare"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Share"
                    android:src="@drawable/ic_share"
                    app:tint="@color/brand_navy" />

                <TextView
                    android:id="@+id/tvShareCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="0"
                    android:textColor="@color/brand_navy"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.example.kayara.NeoCardView>