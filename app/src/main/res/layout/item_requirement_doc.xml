<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="11dp"
    android:layout_marginBottom="9dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="9dp"
        android:background="@drawable/bg_doc_icon"
        android:src="@drawable/ic_nav_documents"
        app:tint="@color/blue_deep"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="11dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDocName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Document.pdf"
            android:textColor="@color/dark_blue"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDocMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uploaded date · size"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDocStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp"
        android:text="APPROVED"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>