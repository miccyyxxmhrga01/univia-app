<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/registrationScene"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/campus_login_background">
    <FrameLayout android:id="@+id/registrationHeader" android:layout_width="0dp" android:layout_height="100dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
            android:orientation="vertical" android:gravity="center_horizontal">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="60dp" android:gravity="center" android:orientation="horizontal">
                <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/neo_circle">
                    <ImageView android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center" android:src="@drawable/bisu_logo" android:contentDescription="@string/bisu_logo_description" />
                </FrameLayout>
                <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="8dp" android:background="@drawable/neo_circle">
                    <ImageView android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center" android:src="@drawable/univia_logo" android:contentDescription="@string/univia_logo_description" />
                </FrameLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/campus_login_name"
                android:textSize="14sp" android:fontFamily="@font/poppins_semibold" android:textColor="@color/white"
                android:shadowColor="#B34F355F" android:shadowRadius="3" android:shadowDy="1" />
        </LinearLayout>
    </FrameLayout>
    <com.example.kayara.CampusGlassCard android:id="@+id/registrationCard" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginHorizontal="14dp" android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/registrationHeader" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
            android:paddingHorizontal="24dp" android:paddingTop="18dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp"
                    android:src="@drawable/registration_back_arrow" android:contentDescription="@string/registration_exit"
                    android:background="@drawable/neo_circle" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/registrationContext" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp" android:fontFamily="@font/poppins_semibold"
                    android:textSize="14sp" android:textColor="@color/text_primary" android:text="@string/registration_student" />
            </LinearLayout>
            <LinearLayout android:id="@+id/registrationStepTrack" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal" />
            <TextView android:id="@+id/registrationProgress" style="@style/RegistrationBody" android:layout_marginTop="10dp"
                android:textSize="12sp" android:fontFamily="@font/poppins_semibold" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/registrationTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:fontFamily="@font/poppins_bold" android:textSize="23sp"
                android:textColor="@color/text_primary" android:includeFontPadding="false" android:accessibilityHeading="true" />
            <TextView android:id="@+id/registrationSubtitle" style="@style/RegistrationBody" android:layout_marginTop="3dp" />
            <androidx.core.widget.NestedScrollView android:id="@+id/signUpScroll" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="4dp" android:fillViewport="true" android:clipToPadding="false"
                android:paddingBottom="12dp" android:overScrollMode="ifContentScrolls">
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:descendantFocusability="afterDescendants">
                    <LinearLayout android:id="@+id/registrationStep1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible"><TextView style="@style/RegistrationLabel" android:text="@string/registration_full_name" android:labelFor="@id/etFullName" /><EditText android:id="@+id/etFullName" style="@style/RegistrationInput" android:hint="@string/registration_name_hint" android:inputType="textCapWords"  /><TextView style="@style/RegistrationLabel" android:text="@string/registration_student_id" android:labelFor="@id/etStudentId" /><EditText android:id="@+id/etStudentId" style="@style/RegistrationInput" android:hint="@string/registration_id_hint" android:inputType="number"  /><TextView style="@style/RegistrationLabel" android:text="@string/registration_course" android:labelFor="@id/spinnerCourse" /><FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <Spinner android:id="@+id/spinnerCourse" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp"
        android:paddingEnd="34dp" android:background="@drawable/neo_inset" android:spinnerMode="dropdown" android:entries="@array/course_list" />
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp"
        android:src="@drawable/bg_dropdown_arrow" android:contentDescription="@null" android:importantForAccessibility="no" />
    </FrameLayout><TextView style="@style/RegistrationLabel" android:text="@string/registration_year" android:labelFor="@id/spinnerYearLevel" /><FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <Spinner android:id="@+id/spinnerYearLevel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp"
        android:paddingEnd="34dp" android:background="@drawable/neo_inset" android:spinnerMode="dropdown" android:entries="@array/year_level_list" />
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp"
        android:src="@drawable/bg_dropdown_arrow" android:contentDescription="@null" android:importantForAccessibility="no" />
    </FrameLayout></LinearLayout><LinearLayout android:id="@+id/registrationStep2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView style="@style/RegistrationLabel" android:text="@string/registration_email" android:labelFor="@id/etEmail" /><EditText android:id="@+id/etEmail" style="@style/RegistrationInput" android:hint="@string/registration_email_hint" android:inputType="textEmailAddress"  /><TextView style="@style/RegistrationBody" android:layout_marginTop="12dp" android:text="@string/registration_email_help" /><TextView style="@style/RegistrationLabel" android:text="@string/registration_username" android:labelFor="@id/etUsername" /><EditText android:id="@+id/etUsername" style="@style/RegistrationInput" android:hint="@string/registration_username_hint" android:inputType="text"  /><TextView style="@style/RegistrationLabel" android:text="@string/registration_password" android:labelFor="@id/etPassword" /><FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <EditText android:id="@+id/etPassword" style="@style/RegistrationInput" android:hint="@string/registration_password_hint"
        android:inputType="textPassword" android:paddingEnd="60dp" android:saveEnabled="false" />
      <ImageView android:id="@+id/btnTogglePassword" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="end|center_vertical" android:layout_marginEnd="5dp" android:padding="13dp"
        android:src="@drawable/ic_eye" android:contentDescription="@string/registration_show_password"
        android:clickable="true" android:focusable="true" />
    </FrameLayout><TextView style="@style/RegistrationLabel" android:text="@string/registration_confirm" android:labelFor="@id/etConfirmPassword" /><FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <EditText android:id="@+id/etConfirmPassword" style="@style/RegistrationInput" android:hint="@string/registration_confirm_hint"
        android:inputType="textPassword" android:paddingEnd="60dp" android:saveEnabled="false" />
      <ImageView android:id="@+id/btnToggleConfirmPassword" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="end|center_vertical" android:layout_marginEnd="5dp" android:padding="13dp"
        android:src="@drawable/ic_eye" android:contentDescription="@string/registration_show_confirm"
        android:clickable="true" android:focusable="true" />
    </FrameLayout></LinearLayout><LinearLayout android:id="@+id/registrationStep3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView style="@style/RegistrationLabel" android:text="@string/registration_interest_label" android:labelFor="@id/etInterest" /><EditText android:id="@+id/etInterest" style="@style/RegistrationInput" android:hint="@string/registration_interest_hint" android:inputType="textCapSentences|textMultiLine" android:singleLine="false" android:minLines="4" android:gravity="top|start" /><TextView style="@style/RegistrationBody" android:layout_marginTop="12dp" android:text="@string/registration_interest_help" /></LinearLayout><LinearLayout android:id="@+id/registrationStep4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><LinearLayout android:id="@+id/registrationReviewDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /><TextView style="@style/RegistrationBody" android:layout_marginTop="12dp" android:text="@string/registration_student_notice" /></LinearLayout>
                </FrameLayout>
            </androidx.core.widget.NestedScrollView>
            <TextView android:id="@+id/tvError" style="@style/RegistrationBody" android:layout_marginVertical="5dp"
                android:textSize="12sp" android:textColor="@color/error" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/registrationNext" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:paddingHorizontal="22dp" android:paddingVertical="14dp" android:gravity="center"
                android:background="@drawable/neo_primary" android:text="@string/registration_next" android:textColor="@color/white"
                android:textSize="15sp" android:fontFamily="@font/poppins_semibold" android:drawableEnd="@drawable/glass_arrow_forward"
                android:clickable="true" android:focusable="true" />
            <LinearLayout android:id="@+id/btnSignUp" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:paddingHorizontal="22dp" android:paddingVertical="14dp" android:gravity="center"
                android:orientation="horizontal" android:background="@drawable/neo_primary" android:visibility="gone"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center" android:fontFamily="@font/poppins_semibold" android:textSize="15sp"
                    android:textColor="@color/white" android:text="@string/registration_create" />
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/glass_arrow_forward" android:contentDescription="@null" />
            </LinearLayout>
            <TextView android:id="@+id/tvGoToLogin" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:paddingTop="12dp" android:gravity="center" android:text="@string/registration_login"
                android:textSize="12sp" android:textColor="@color/login_secondary" android:fontFamily="@font/poppins_semibold"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </com.example.kayara.CampusGlassCard>
</androidx.constraintlayout.widget.ConstraintLayout>
