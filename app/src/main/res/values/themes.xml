<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Univia" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_navy</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_muted</item>
        <item name="colorOnPrimaryContainer">@color/brand_navy</item>
        <item name="colorSecondary">@color/brand_gold_dark</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/brand_gold_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_navy</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:colorAccent">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="materialButtonStyle">@style/Widget.Univia.Button</item>
        <item name="android:editTextStyle">@style/Widget.Univia.Input</item>
    </style>
    <style name="Theme.Univia" parent="Base.Theme.Univia" />
    <style name="Widget.Univia.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">22dp</item><item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/neo_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Univia.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/neo_inset</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
